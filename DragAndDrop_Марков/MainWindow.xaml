<Window x:Class="DragAndDrop_Марков.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DragAndDrop_Марков"
        mc:Ignorable="d"
        Title="PhotoEdit" Height="600" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10" HorizontalAlignment="Center">
            <Button x:Name="LoadImageButton" Content="Загрузить фото" Click="LoadImageButton_Click"
                    Margin="5" Padding="10,5"/>
            <Button x:Name="CropButton" Content="Обрезать" Click="CropButton_Click"
                    Margin="5" Padding="10,5"/>
            <Button x:Name="SaveButton" Content="Сохранить" Click="SaveButton_Click"
                    Margin="5" Padding="10,5"/>
            <Button x:Name="ResetButton" Content="Сбросить" Click="ResetButton_Click"
        Margin="5" Padding="10,5"/>
        </StackPanel>



        <Border Grid.Row="1" Margin="10" MouseDown="Canvas_MouseDown" MouseMove="Canvas_MouseMove" MouseUp="CanvasMouseUp">
            <Grid>
                <Image x:Name="MainImage"/>

                <Border x:Name="CropRect" BorderBrush="Yellow">
                    <Border x:Name="ResizeHandle" Width="12" Height="12"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            MouseDown="ResizeHandle_MouseDown"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
